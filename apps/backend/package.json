    "datatables.net-buttons-dt": "^3.2.5",
    "datatables.net-datetime": "^1.6.1",
    "datatables.net-dt": "^2.1.8",
    "datatables.net-fixedheader": "^4.0.4",
    "datatables.net-plugins": "^2.3.2",
    "datatables.net-responsive": "^3.0.7",
    "datatables.net-select": "^3.1.3",
    "jquery": "^3.7.1",
    "jszip": "^3.10.1",
    "moment": "^2.30.1",
    "pdfmake": "^0.2.20"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
