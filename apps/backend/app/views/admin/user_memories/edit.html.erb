<div class="px-4 sm:px-6 lg:px-8 max-w-3xl space-y-6">
  <div>
    <%= link_to "← Cancelar", admin_user_memory_path(@user, @insight["id"]),
                class: "text-xs text-gray-500 hover:text-gray-700" %>
    <h1 class="mt-1 text-2xl font-bold text-gray-900">Editar insight</h1>
    <p class="mt-1 text-xs font-mono text-gray-500"><%= @insight["id"] %></p>
  </div>

  <%= form_with url: admin_user_memory_path(@user, @insight["id"]),
                method: :patch, local: true, class: "bg-white shadow rounded-lg overflow-hidden" do |f| %>
    <div class="px-6 py-5 border-b border-gray-100 flex items-center gap-2">
      <span class="inline-flex items-center rounded-full bg-orange-50 px-2 py-0.5 text-xs font-medium text-orange-700 capitalize">
        <%= @insight["category"] %>
      </span>
      <span class="font-mono text-xs text-gray-600 px-2 py-0.5 rounded-full bg-gray-100">
        <%= @insight["source"] %>
      </span>
      <span class="ml-auto text-xs text-gray-500">
        Solo el contenido es editable. Cambiar el contenido regenera el embedding.
      </span>
    </div>
    <div class="px-6 py-6">
      <%= text_area_tag "insight[content]", @insight["content"],
          rows: 8,
          class: "block w-full rounded-md border-gray-300 text-sm focus:ring-orange-500 focus:border-orange-500" %>
    </div>
    <div class="px-6 py-3 bg-gray-50 border-t border-gray-100 flex items-center justify-end gap-2">
      <%= link_to "Cancelar", admin_user_memory_path(@user, @insight["id"]),
                  class: "inline-flex items-center rounded-md bg-white px-3 py-1.5 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50" %>
      <%= submit_tag "Guardar",
          class: "inline-flex items-center rounded-md bg-orange-600 px-4 py-1.5 text-sm font-semibold text-white hover:bg-orange-700" %>
    </div>
  <% end %>
</div>
