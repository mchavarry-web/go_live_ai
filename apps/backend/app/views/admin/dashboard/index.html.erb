<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">Panel administrativo</h1>
      <p class="mt-2 text-sm text-gray-700">
        Visión general de la plataforma Go Live.
      </p>
    </div>
  </div>

  <!-- Core metric cards -->
  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
    <%= render "stat_card", title: "Usuarios",           value: @users_count,         hint: "#{@admins_count} admin · #{@onboarded_count} onboarded", href: admin_users_path %>
    <%= render "stat_card", title: "Conversaciones",     value: @conversations_count, hint: "#{@messages_count} mensajes en total" %>
    <%= render "stat_card", title: "Saludos proactivos", value: @proactive_count,     hint: "mensajes iniciados por el avatar" %>
    <%= render "stat_card", title: "Dispositivos push",  value: @device_tokens_count, hint: "tokens FCM activos" %>
  </div>

  <!-- Social / ingestion panel -->
  <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="lg:col-span-1 bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">Conexiones sociales</h2>
        <%= link_to "Panel Instagram", admin_instagram_path, class: "text-sm text-orange-600 hover:text-orange-500" %>
      </div>
      <dl class="px-6 py-4 space-y-2">
        <% %w[instagram facebook twitter spotify].each do |p| %>
          <div class="flex items-center justify-between text-sm">
            <dt class="capitalize text-gray-600"><%= p %></dt>
            <dd class="font-semibold text-gray-900"><%= @social_totals[p].to_i %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="lg:col-span-2 bg-white shadow rounded-lg">
      <div class="px-6 py-4 border-b border-gray-100">
        <h2 class="text-base font-semibold text-gray-900">Usuarios recientes</h2>
      </div>
      <ul class="divide-y divide-gray-100">
        <% @recent_users.each do |u| %>
          <li class="px-6 py-3 text-sm flex items-center justify-between">
            <div>
              <%= link_to u.email, admin_user_path(u), class: "font-medium text-gray-900 hover:text-orange-600" %>
              <span class="ml-2 text-xs text-gray-500">
                <%= u.provider || "email" %> · <%= u.country || "—" %>
              </span>
            </div>
            <div class="text-xs text-gray-500"><%= time_ago_in_words(u.created_at) %> ago</div>
          </li>
        <% end %>
        <% if @recent_users.empty? %>
          <li class="px-6 py-3 text-sm text-gray-500">No hay usuarios todavía.</li>
        <% end %>
      </ul>
    </div>
  </div>

  <!-- Recent chat activity -->
  <div class="mt-10 bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-100">
      <h2 class="text-base font-semibold text-gray-900">Mensajes recientes</h2>
    </div>
    <ul class="divide-y divide-gray-100">
      <% @recent_messages.each do |m| %>
        <li class="px-6 py-3 text-sm">
          <div class="flex items-center justify-between">
            <div>
              <span class="inline-flex items-center rounded-full bg-<%= m.role == "user" ? "blue" : "green" %>-50 px-2 py-0.5 text-xs font-medium text-<%= m.role == "user" ? "blue" : "green" %>-700 mr-2"><%= m.role %></span>
              <%= link_to m.conversation.user.email, admin_user_path(m.conversation.user), class: "text-gray-900 hover:text-orange-600" %>
              <% if m.proactive_skill.present? %>
                <span class="ml-2 inline-flex items-center rounded-full bg-purple-50 px-2 py-0.5 text-xs text-purple-700">proactive · <%= m.proactive_skill %></span>
              <% end %>
            </div>
            <div class="text-xs text-gray-500"><%= time_ago_in_words(m.created_at) %> ago</div>
          </div>
          <div class="mt-1 text-gray-700 line-clamp-1"><%= truncate(m.content, length: 120) %></div>
        </li>
      <% end %>
      <% if @recent_messages.empty? %>
        <li class="px-6 py-3 text-sm text-gray-500">Sin actividad aún.</li>
      <% end %>
    </ul>
  </div>
</div>
