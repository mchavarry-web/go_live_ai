<% if flash.any? %>
  <div class="mb-4">
    <% flash.each do |type, message| %>
      <%
        case type.to_sym
        when :notice
          alert_class = "bg-green-50 border-l-4 border-green-400 text-green-700"
          icon_color = "text-green-400"
        when :alert, :error
          alert_class = "bg-red-50 border-l-4 border-red-400 text-red-700"
          icon_color = "text-red-400"
        when :warning
          alert_class = "bg-yellow-50 border-l-4 border-yellow-400 text-yellow-700"
          icon_color = "text-yellow-400"
        else
          alert_class = "bg-blue-50 border-l-4 border-blue-400 text-blue-700"
          icon_color = "text-blue-400"
        end
      %>

      <div class="<%= alert_class %> p-4 mb-2" data-controller="dismissible">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 <%= icon_color %>" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="ml-3 flex-1">
            <p class="text-sm"><%= message %></p>
          </div>
          <div class="ml-auto pl-3">
            <button type="button"
                    class="-mx-1.5 -my-1.5 rounded-md p-1.5 inline-flex hover:bg-gray-100 focus:outline-none"
                    data-action="click->dismissible#dismiss">
              <span class="sr-only">Cerrar</span>
              <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
