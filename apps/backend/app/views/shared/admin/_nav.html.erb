<nav class="shadow-sm" style="background-color: #E65F00;" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16">
      <div class="flex">
        <!-- Logo -->
        <div class="flex-shrink-0 flex items-center">
          <%= link_to admin_root_path, class: "text-white text-2xl font-bold" do %>
            MiSOS
          <% end %>
        </div>

        <!-- Desktop Navigation -->
        <div class="hidden sm:ml-6 sm:flex sm:space-x-4 h-full">
          <%= render "shared/admin/nav_links" %>
        </div>
      </div>

      <!-- User Menu -->
      <div class="hidden sm:ml-6 sm:flex sm:items-center h-full">
        <div class="relative h-full flex items-center" data-controller="dropdown">
          <button type="button"
                  class="flex items-center h-full px-2 text-white hover:text-gray-200 focus:outline-none"
                  data-action="click->dropdown#toggle">
            <%= render "shared/user_avatar", user: current_user %>
            <span class="ml-2"><%= current_user.name %></span>
            <svg class="ml-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div data-dropdown-target="menu"
               class="hidden origin-top-right absolute right-0 top-full mt-0 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
            <div class="py-1">
              <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" do %>
                <span>Cerrar Sesión</span>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="-mr-2 flex items-center sm:hidden">
        <button type="button"
                class="inline-flex items-center justify-center p-2 rounded-md text-white hover:text-gray-200 focus:outline-none"
                data-action="click->mobile-menu#toggle">
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="hidden sm:hidden" data-mobile-menu-target="menu">
    <div class="pt-2 pb-3 space-y-1">
      <%= render "shared/admin/nav_links", mobile: true %>
    </div>
    <div class="pt-4 pb-3 border-t border-orange-700">
      <div class="flex items-center px-4">
        <%= render "shared/user_avatar", user: current_user %>
        <div class="ml-3">
          <div class="text-base font-medium text-white"><%= current_user.name %></div>
          <div class="text-sm font-medium text-orange-200"><%= current_user.email %></div>
        </div>
      </div>
      <div class="mt-3 space-y-1">
        <%= button_to destroy_user_session_path,
            method: :delete,
            class: "block w-full text-left px-4 py-2 text-base font-medium text-white hover:text-gray-200" do %>
          <span>Cerrar Sesión</span>
        <% end %>
      </div>
    </div>
  </div>
</nav>
