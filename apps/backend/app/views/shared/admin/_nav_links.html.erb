<% mobile = local_assigns[:mobile] || false %>

<% if mobile %>
  <!-- Mobile Navigation Links -->
  <div class="relative" data-controller="mobile-dropdown">
    <button type="button"
            class="w-full text-left px-4 py-2 text-base font-medium text-white hover:text-gray-200"
            data-action="click->mobile-dropdown#toggle">
      Administración
      <svg class="inline ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    <div data-mobile-dropdown-target="menu" class="hidden pl-4">
      <%= link_to "Usuarios", admin_users_path,
          class: "block px-4 py-2 text-sm text-white hover:text-gray-200" %>
      <%= link_to "Instagram", admin_instagram_path,
          class: "block px-4 py-2 text-sm text-white hover:text-gray-200" %>
    </div>
  </div>
<% else %>
  <!-- Desktop Navigation Links -->
  <div class="relative h-full flex items-center" data-controller="dropdown">
    <button type="button"
            class="inline-flex items-center h-full px-3 text-sm font-medium text-white hover:text-gray-200 focus:outline-none"
            data-action="click->dropdown#toggle">
      <span>Administración</span>
      <svg class="ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute left-0 top-full mt-0 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
      <div class="py-1">
        <%= link_to "Usuarios", admin_users_path,
            class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
        <%= link_to "Instagram", admin_instagram_path,
            class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
      </div>
    </div>
  </div>
<% end %>
