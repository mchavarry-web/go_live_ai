# Committed on purpose (gitignore exception) — contains no secrets.
#
# DEV-111 belt-and-braces: dotenv-rails loads `.env` even under
# RAILS_ENV=test (after this file — earlier files win per key). If a
# developer's local `.env` still carries DATABASE_URL, this pin keeps
# every test-env command on the test database instead of silently
# reading/writing development data. test/test_helper.rb pins the same
# value for suite runs; this file covers CLI paths like
# `bin/rails db:test:prepare`.
DATABASE_URL=postgres:///go_live_backend_test
