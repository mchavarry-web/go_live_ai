# Rails (apps/backend) env — copy to apps/backend/.env

# Database — local Postgres, current user via Unix socket (Homebrew default)
DATABASE_URL=postgres:///go_live_backend_development

# Redis (Sidekiq; ActionCable only uses Redis in prod per config/cable.yml)
REDIS_URL=redis://localhost:6379/5

# Rails 8 secret (generate with: bin/rails secret)
SECRET_KEY_BASE=change_me_generate_with_bin_rails_secret

# Internal boundary to the FastAPI ai-agents service
AI_AGENTS_BASE_URL=http://localhost:8001
AI_AGENTS_INTERNAL_TOKEN=change_me_shared_with_ai_agents_env

# Social login (server-side verification; no omniauth)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_SERVICE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Spotify OAuth (server-side flow in Rails)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/v1/spotify/callback

# FCM push notifications — HTTP v1 with a Firebase service account.
# Provide EITHER a path to the service-account JSON file...
GOOGLE_APPLICATION_CREDENTIALS=
# ...or the JSON itself inline (single line). Leave both empty in dev to no-op.
FCM_SERVICE_ACCOUNT_JSON=
# Optional override; defaults to the service-account JSON's project_id.
FCM_PROJECT_ID=

# Shrine S3 (leave empty in dev — initializer falls back to local storage/)
S3_AWS_STORAGE_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ActiveRecord encryption (SocialConnection tokens). Generate with:
#   bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# OmniAuth — web flows only. Google/Apple/Facebook client credentials.
# Apple sign-in on web requires a Service ID + private key registered in the
# Apple Developer console; paste the PEM here as one line (literal \n).
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
