[Unit]
Description=Go Live FastAPI ai-agents service (uvicorn)
After=network.target postgresql.service redis.service
Requires=postgresql.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/ai_agents/current

# `.env` lives in shared/ and is symlinked into current/. EnvironmentFile
# can read symlinks fine. Keep INTERNAL_TOKEN in here so it never leaks
# into systemctl status / journalctl output.
EnvironmentFile=/home/deploy/ai_agents/current/.env

# Bind to localhost only — Rails (on the same box) is the sole caller.
# Never expose :8001 publicly; FastAPI has no auth beyond X-Internal-Token.
ExecStart=/home/deploy/ai_agents/current/.venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8001 \
    --workers 2

Restart=on-failure
RestartSec=3

# Sensible hardening — adjust if a chain ever needs to touch the wider FS.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

# uvicorn reaps its own workers on SIGTERM cleanly within ~10s.
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
