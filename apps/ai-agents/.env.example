# Environment
ENVIRONMENT=development
DEBUG=true

# ===================
# LangSmith (Observability) - REQUIRED
# ===================
# Get your API key at: https://smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_api_key_here
LANGSMITH_PROJECT=golive-ai-agents
LANGCHAIN_TRACING_V2=true

# ===================
# LLM Provider Configuration
# ===================
LLM_PROVIDER=openai  # Options: openai, anthropic

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=o4-mini

# Anthropic (alternative)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===================
# Embeddings
# ===================
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ===================
# Database (PostgreSQL + pgvector)
# ===================
DATABASE_URL=postgresql+asyncpg://golive:password@localhost:5432/golive

# ===================
# Redis
# ===================
REDIS_URL=redis://localhost:6379

# ===================
# Web Search (Real-time)
# ===================
# Enable web search tool-calling for the avatar agent
WEB_SEARCH_ENABLED=true
# Allow the agent to verify facts proactively (more Tavily calls; set false for tests)
WEB_SEARCH_PROACTIVE_FACTUAL=true
# Tavily Search API key - get one at: https://app.tavily.com
# If empty, falls back to DuckDuckGo (no API key required, less accurate)
TAVILY_API_KEY=tvly-your-tavily-api-key
# Maximum number of search results to include per query (1-10)
WEB_SEARCH_MAX_RESULTS=3
# Maximum total tool calls (web_search + fetch_urls) per conversation turn (1-20)
WEB_SEARCH_MAX_CALLS=5
# Max URLs per fetch_urls tool call when user pastes links (Tavily Extract, 1-10)
FETCH_URL_MAX_URLS=5

# ===================
# CORS
# ===================
# Comma-separated allowed origins, or '*' for all (dev only)
CORS_ALLOWED_ORIGINS=*

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
