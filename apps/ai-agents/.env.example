# FastAPI (apps/ai-agents) env — copy to apps/ai-agents/.env

# Database — local Postgres (separate DB on the same server, pgvector enabled)
DATABASE_URL=postgresql+asyncpg:///go_live_ai_agents_development

# Redis
REDIS_URL=redis://localhost:6379

# Shared secret with Rails; every /internal/* request must carry
# X-Internal-Token with this exact value. MUST match AI_AGENTS_INTERNAL_TOKEN
# in apps/backend/.env.
INTERNAL_TOKEN=change_me_shared_with_rails_backend

# LLMs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=go-live-dev

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
