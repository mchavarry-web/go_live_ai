# Staging environment — copied to .env by `yarn start:staging`.
# Fill in real staging hosts + client IDs before shipping a build.

API_URL=https://staging.golive.example.com/api/v1
CABLE_URL=wss://staging.golive.example.com/cable
NODE_ENV=staging
API_TIMEOUT=15000
DEBUG=false

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
FACEBOOK_APP_ID=
