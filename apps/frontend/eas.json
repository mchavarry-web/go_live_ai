{
  "cli": {
    "version": ">= 13.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "http://localhost:3000/api/v1",
        "CABLE_URL": "ws://localhost:3000/cable",
        "NODE_ENV": "development",
        "API_TIMEOUT": "15000",
        "DEBUG": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://golive.devtechperu.net/api/v1",
        "CABLE_URL": "wss://golive.devtechperu.net/cable",
        "NODE_ENV": "staging",
        "API_TIMEOUT": "15000",
        "DEBUG": "true"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "API_URL": "https://golive.devtechperu.net/api/v1",
        "CABLE_URL": "wss://golive.devtechperu.net/cable",
        "NODE_ENV": "staging",
        "API_TIMEOUT": "15000",
        "DEBUG": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "API_URL": "https://golive.devtechperu.net/api/v1",
        "CABLE_URL": "wss://golive.devtechperu.net/cable",
        "NODE_ENV": "production",
        "API_TIMEOUT": "20000",
        "DEBUG": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "augustosamame@gmail.com",
        "ascAppId": "6764063573"
      },
      "android": {
        "track": "internal"
      }
    },
    "staging": {
      "ios": {
        "appleId": "augustosamame@gmail.com",
        "ascAppId": "6764063573"
      },
      "android": {
        "track": "internal"
      }
    },
    "preview": {
      "ios": {
        "appleId": "augustosamame@gmail.com",
        "ascAppId": "6764063573"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
