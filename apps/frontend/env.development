# Development environment — copied to .env by `yarn start:dev`.
# Safe to commit: no real secrets, all values are localhost or empty stubs.

# ── Rails transport (single source of truth — see app.config.js) ────────
API_URL=http://localhost:3000/api/v1
CABLE_URL=ws://localhost:3000/cable
NODE_ENV=development
API_TIMEOUT=15000
DEBUG=true

# ── Social SDK client IDs ───────────────────────────────────────────────
# Mobile native sign-in. Web flows go through Rails OmniAuth and don't
# need these. Empty values are fine for dev — the SDKs only fail when
# the user actually taps a social button.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
FACEBOOK_APP_ID=
