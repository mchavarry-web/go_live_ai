# Shared between Rails and FastAPI — duplicate into apps/backend/.env and apps/ai-agents/.env as needed.

# ─── Rails (apps/backend) ────────────────────────────────────────────────
DATABASE_URL=postgres://go_live:go_live@localhost:5432/go_live_backend_development
REDIS_URL=redis://localhost:6379/0

# JWT (Rails 8 uses secret_key_base; this mirrors the template pattern)
SECRET_KEY_BASE=change_me_generate_with_bin_rails_secret

# AI agents internal HTTP boundary (matches PORT_PLAN §3.2)
AI_AGENTS_BASE_URL=http://localhost:8001
AI_AGENTS_INTERNAL_TOKEN=change_me_shared_with_ai_agents_env

# Social login (server-side verification; no omniauth)
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_SERVICE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Spotify OAuth (server-side flow lives in Rails)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/v1/spotify/callback

# FCM
FCM_SERVER_KEY=

# ─── FastAPI (apps/ai-agents) ────────────────────────────────────────────
DATABASE_URL_AI=postgresql+asyncpg://go_live:go_live@localhost:5433/go_live_ai_agents_development
INTERNAL_TOKEN=change_me_shared_with_rails_backend

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=go-live-dev
